# Copy to `.env` (gitignored) in this directory and fill in the seeded Cognito test user's
# real credentials (docs/10-roadmap.md prerequisite 7). Used by:
#   - the future Playwright global setup (docs/08-testing.md#end-to-end-tests), which signs in
#     through the real Cognito hosted UI
#   - services/api/tests/integration/conftest.py, which reads the same values via
#     ADMIN_USER_PASSWORD_AUTH so integration tests don't need a browser
CWD_E2E_TEST_USER_EMAIL=
CWD_E2E_TEST_USER_PASSWORD=
